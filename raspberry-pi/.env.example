# Copy to .env and fill in. .env is git-ignored.

# 1 = fake sensor values, no GPIO (for testing on a laptop)
SIMULATE=0
SAMPLE_INTERVAL=5

HTTP_HOST=0.0.0.0
HTTP_PORT=8000

# HiveMQ public broker. Change TOPIC_PREFIX to something unique,
# the broker is shared with everyone.
MQTT_HOST=mqtt-dashboard.com
MQTT_PORT=1883
TOPIC_PREFIX=take-home-iot

# ChirpStack MQTT integration
LORA_MQTT_HOST=lora.kmitl.ac.th
LORA_MQTT_PORT=1883
LORA_MQTT_USER=
LORA_MQTT_PASS=
LORA_APPLICATION_ID=
# DevEUI lowercase hex, as in the ChirpStack topic (from reference/lora-uno-r4/chirpstack.txt)
LORA_DEV_EUI=0a1930bd3503d95c
